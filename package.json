{
  "name": "ham-web-server",
  "version": "2.0.0",
  "description": "一个支持 IoC 的 TypeScript Web 服务器框架（ham-web-server 1.x 的重构版）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "demo": "npm run build && node dist/examples/demo/main.js",
    "board": "npm run build && node dist/examples/message-board/main.js",
    "dinner": "npm run build && node dist/examples/dinner/main.js",
    "bench": "npm run build && node scripts/bench.js",
    "bench:node": "npm run build && node scripts/bench-node.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "server",
    "mvc",
    "ioc",
    "di",
    "typescript",
    "framework",
    "web-framework",
    "pm2",
    "cluster",
    "sqlite",
    "mysql",
    "orm",
    "session",
    "logging",
    "pino",
    "art-template"
  ],
  "author": "as3long <as3long@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as3long/ham-web-server.git"
  },
  "homepage": "https://github.com/as3long/ham-web-server#readme",
  "bugs": {
    "url": "https://github.com/as3long/ham-web-server/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "art-template": "^4.13.2",
    "formidable": "^3.5.2",
    "mime": "^3.0.0",
    "mysql2": "^3.11.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "xss": "^1.0.15"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/mime": "^3.0.4",
    "@types/node": "^24.0.0",
    "autocannon": "^8.0.0",
    "typescript": "^5.5.4"
  }
}
